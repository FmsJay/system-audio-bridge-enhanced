+//******************//
+//    SOFTPHONE     //
+//******************//
+
+// Softphone jump-in, when the per-PC setting is on: this side starts and watches vm-softphone.exe, draws what
+// it publishes, and passes on the menu commands. The mic rules, F9 and the network all live in the helper.
+namespace softphone_ui
+{
+    constexpr UINT_PTR kMenuAuto = 0x133C, kMenuFlip = 0x133D;
+    constexpr uint64_t kPollMs = 100, kHeartbeatMs = 3000, kHungMs = 10000, kRelaunchMs = 5000;
+    constexpr DWORD kExitWaitMs = 1500;
+
+    static bool enabled = false;
+    static bool auto_mode = true;
+    static HMENU menu = nullptr;
+    static HANDLE process = nullptr;
+    static HANDLE mapping = nullptr;
+    static const softphone::SharedStatus* shared = nullptr;
+    static softphone::SharedStatus latest = {};
+    static bool have_status = false;
+    static bool was_open = false;
+    static uint64_t next_poll = 0, next_launch = 0;
+    static softphone::View view;
+    static softphone::Overlay& overlay = *new softphone::Overlay();   // never freed: DirectWrite may be gone by process exit
+
+    static std::wstring folder_of_dll()
+    {
+        wchar_t path[MAX_PATH] = {};
+        HMODULE self = nullptr;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                reinterpret_cast<LPCWSTR>(&folder_of_dll), &self)
+            || !GetModuleFileNameW(self, path, MAX_PATH))
+            return {};
+        const wchar_t* slash = wcsrchr(path, L'\\');
+        return slash ? std::wstring(path, slash - path) : std::wstring{};
+    }
+
+    static HWND helper_window()
+    {
+        return FindWindowExW(HWND_MESSAGE, nullptr, softphone::kWindowClass, nullptr);
+    }
+
+    static void launch(HWND hwnd)
+    {
+        const auto& cfg = cm->get_softphone();
+        const auto host = utils::str_to_wstr(cfg.host_ip);
+        const auto state = utils::str_to_wstr(cfg.state_file);
+        const auto key = utils::str_to_wstr(cfg.hotkey);
+        const auto docs = utils::get_userprofile_path();
+        const std::wstring dir = folder_of_dll();
+        if (!host || !state || !key || dir.empty())
+            return;
+
+        std::wstring cmd = L"\"" + dir + L"\\vm-softphone.exe\" --parent " + std::to_wstring(GetCurrentProcessId())
+            + L" --mixer-hwnd " + std::to_wstring(reinterpret_cast<INT_PTR>(hwnd))
+            + L" --host \"" + *host + L"\" --state \"" + *state + L"\" --hotkey \"" + *key + L"\""
+            + L" --bus " + std::to_wstring(cfg.send_bus) + L" --mic-strip " + std::to_wstring(cfg.mic_strip)
+            + L" --auto " + (auto_mode ? L"1" : L"0");
+        if (docs)
+            cmd += L" --log \"" + *docs + L"\\softphone.log\"";
+
+        STARTUPINFOW si = {sizeof(si)};
+        PROCESS_INFORMATION pi = {};
+        if (CreateProcessW(nullptr, cmd.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr, dir.c_str(), &si, &pi))
+        {
+            CloseHandle(pi.hThread);
+            if (process)
+                CloseHandle(process);
+            process = pi.hProcess;
+        }
+        else
+            SPDLOG_ERROR("failed to start vm-softphone.exe: {}", GetLastError());
+    }
+
+    // The mic just opened by itself: bring the mixer up where it can be seen, without taking the keyboard.
+    static void show_without_focus(HWND hwnd)
+    {
+        if (IsIconic(hwnd) || !IsWindowVisible(hwnd))
+            ShowWindow(hwnd, SW_SHOWNOACTIVATE);
+        const UINT flags = SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE;
+        o_SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0, flags);
+        o_SetWindowPos(hwnd, HWND_NOTOPMOST, 0, 0, 0, 0, flags);
+    }
+
+    static void init()
+    {
+        const auto flavor = cm->get_current_flavor_id();
+        enabled = cm->get_softphone().enabled && flavor && *flavor == FLAVOR_POTATO;
+        if (!enabled)
+            return;
+        auto_mode = cm->reg_get_softphone_auto();
+        wm->set_main_overlay([](ID2D1DeviceContext* ctx, float w, float h) { overlay.draw(ctx, w, h, view); });
+    }
+
+    // Called from the main window's UI timer. No file or network access: a named-memory read and a process check.
+    static void tick(HWND hwnd)
+    {
+        if (!enabled)
+            return;
+        const uint64_t now = GetTickCount64();
+        if (now < next_poll)
+            return;
+        next_poll = now + kPollMs;
+
+        if (!shared)
+        {
+            mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, softphone::kStatusName);
+            if (mapping)
+                shared = static_cast<const softphone::SharedStatus*>(MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(softphone::SharedStatus)));
+        }
+        if (shared && softphone::readStatus(shared, latest))
+            have_status = true;
+
+        const bool running = process && WaitForSingleObject(process, 0) == WAIT_TIMEOUT;
+        const uint64_t age = have_status ? now - latest.heartbeat : UINT64_MAX;
+        const bool alive = running && age < kHeartbeatMs;
+
+        // Stuck rather than gone: replace it. Its safe startup closes the mic.
+        if (running && have_status && age > kHungMs)
+            TerminateProcess(process, 1);
+
+        if (!running && now >= next_launch)
+        {
+            next_launch = now + kRelaunchMs;
+            have_status = false;
+            launch(hwnd);
+        }
+
+        const bool open = alive && (latest.flags & softphone::kMicOpen) != 0;
+        if (open && !was_open && (latest.flags & softphone::kOpenedAutomatically) != 0)
+            show_without_focus(hwnd);
+        if (alive)
+            was_open = open;
+
+        // Before the first status there's nothing to report yet, unless the helper really isn't starting.
+        const softphone::SharedStatus empty = {};
+        if (alive)
+            view = softphone::describe(true, was_open, latest);
+        else if (running && !have_status)
+            view = softphone::describe(true, false, [] { softphone::SharedStatus s = {}; s.flags = softphone::kWaitingForMixer; return s; }());
+        else
+            view = softphone::describe(false, was_open, empty);
+    }
+
+    static void toggle_auto()
+    {
+        auto_mode = !auto_mode;
+        cm->reg_save_softphone_auto(auto_mode);
+        if (menu)
+            CheckMenuItem(menu, static_cast<UINT>(kMenuAuto), MF_BYCOMMAND | (auto_mode ? MF_CHECKED : MF_UNCHECKED));
+        if (HWND helper = helper_window())
+            PostMessageW(helper, softphone::kMsgSetAuto, auto_mode ? 1 : 0, 0);
+    }
+
+    static void flip()
+    {
+        if (HWND helper = helper_window())
+            PostMessageW(helper, softphone::kMsgFlip, 0, 0);
+    }
+
+    // The bus and stream go back to how setup left them, ideally before the mixer writes its settings.
+    static void shutdown()
+    {
+        if (!enabled || !process)
+            return;
+        enabled = false;
+        if (HWND helper = helper_window())
+        {
+            PostMessageW(helper, softphone::kMsgShutdown, 0, 0);
+            WaitForSingleObject(process, kExitWaitMs);
+        }
+    }
+}
