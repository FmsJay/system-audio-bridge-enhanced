+/**
+ * Whether automatic mic is on. Kept in the registry so the Potato menu can change it, and on unless turned off.
+ */
+bool config_manager::reg_get_softphone_auto()
+{
+    DWORD value = 1, size = sizeof(value);
+    const LSTATUS result = RegGetValueW(HKEY_CURRENT_USER, reg_sub_key_potato.c_str(), L"softphone_auto", RRF_RT_REG_DWORD, nullptr, &value, &size);
+    return result != ERROR_SUCCESS || value != 0;
+}
+
+void config_manager::reg_save_softphone_auto(bool on)
+{
+    const DWORD value = on ? 1 : 0;
+    RegSetKeyValueW(HKEY_CURRENT_USER, reg_sub_key_potato.c_str(), L"softphone_auto", REG_DWORD, &value, sizeof(value));
+}
