 LRESULT ARCH_CALL hk_WndProc_main(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
 {
+    if (msg == WM_COMMAND && HIWORD(wParam) == 0 && lParam == 0)
+    {
+        const wchar_t* target = nullptr;
+        const wchar_t* arguments = nullptr;
+        const wchar_t* failure = L"Windows could not open the selected audio settings.";
+        wchar_t control_path[MAX_PATH] = {};
+        switch (LOWORD(wParam))
+        {
+        case 0x133B:
+        {
+            // vm-sessions.exe ships next to this DLL and runs as its own process.
+            HMODULE self = nullptr;
+            if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                    reinterpret_cast<LPCWSTR>(&hk_WndProc_main), &self)
+                || !GetModuleFileNameW(self, control_path, MAX_PATH))
+                return 0;
+            wchar_t* slash = wcsrchr(control_path, L'\\');
+            if (!slash || wcscpy_s(slash + 1, MAX_PATH - (slash + 1 - control_path), L"vm-sessions.exe") != 0)
+                return 0;
+            target = control_path;
+            failure = L"vm-sessions.exe was not found next to vmchroma64.dll.";
+            break;
+        }
+        case 0x1338: target = L"ms-settings:sound"; break;
+        case 0x1339: target = L"ms-settings:apps-volume"; break;
+        case 0x133A:
+            if (!GetSystemDirectoryW(control_path, MAX_PATH - 13))
+                return 0;
+            wcscat_s(control_path, L"\\control.exe");
+            target = control_path;
+            arguments = L"mmsys.cpl";
+            break;
+        }
+        if (target)
+        {
+            const auto result = reinterpret_cast<INT_PTR>(
+                ShellExecuteW(hwnd, L"open", target, arguments, nullptr, SW_SHOWNORMAL));
+            if (result <= 32)
+                MessageBoxW(hwnd, failure, L"Audio Settings", MB_OK | MB_ICONERROR);
+            return 0;
+        }
+    }
+
     if (msg == WM_COMMAND && LOWORD(wParam) == 0x1337)
         ShellExecuteW(nullptr, L"open", L"https://github.com/emkaix/voicemeeter-chroma", nullptr, nullptr, SW_SHOW);
 
